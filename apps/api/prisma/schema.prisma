// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  AUTHOR
  STUDENT
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  username           String?
  firstName          String?
  lastName           String?
  avatarUrl          String?
  bio                String?
  roles              Role[]              @default([STUDENT])
  isActive           Boolean             @default(true)
  expertisorId       String?             @unique
  lastLoginAt        DateTime?
  authorApplications AuthorApplication[]
  createdProducts    Product[]           @relation("ProductCreatedBy")
  updatedProducts    Product[]           @relation("ProductUpdatedBy")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  Course             Course[]
  Bundle             Bundle[]
  Workshop           Workshop[]
  submittedCourses   CourseSubmission[] @relation("SubmissionSubmittedBy")
  reviewedCourses    CourseSubmission[] @relation("SubmissionReviewedBy")
  auditLogs          AuditLog[]         @relation("AuditLogActor")
  enrollments        Enrollment[]       @relation("UserEnrollments")
  revokedEnrollments Enrollment[]       @relation("RevokedEnrollments")
  certificates       Certificate[]      @relation("UserCertificates")
  orders             Order[]            @relation("UserOrders")
  questionnaireAttempts QuestionnaireAttempt[] @relation("UserQuestionnaireAttempts")

  @@index([email])
  @@index([isActive])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum AuditAction {
  COURSE_CREATED
  COURSE_SUBMITTED
  COURSE_APPROVED
  COURSE_CHANGES_REQUESTED
  COURSE_PUBLISHED
  COURSE_UNPUBLISHED
  COURSE_ARCHIVED
  USER_CREATED
  USER_ROLE_CHANGED
  USER_SUSPENDED
  USER_ACTIVATED
  ENROLLMENT_CREATED
  ENROLLMENT_REVOKED
  CERTIFICATE_ISSUED
  PAYMENT_UPDATED
  TICKET_UPDATED
  QUESTIONNAIRE_ATTEMPT_SUBMITTED
}

model AuthorApplication {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline     String
  bio          String
  expertise    String[]
  portfolioUrl String?
  sampleVideo  String?
  status       ApplicationStatus @default(PENDING)
  reviewNotes  String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

enum ProductType {
  COURSE
  BUNDLE
  WORKSHOP
}

enum ProductStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  ON_AIR
  OFF_AIR
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum SessionType {
  VIDEO
  TEXT
  LIVE
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum ResourceType {
  PDF
  ZIP
  EXTERNAL_LINK
  GITHUB
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
}

enum WorkshopStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model Product {
  id               String             @id @default(uuid())
  title            String
  slug             String             @unique
  description      String?            @db.Text
  shortDescription String?            @db.Text
  thumbnail        String?
  type             ProductType
  status           ProductStatus      @default(DRAFT)
  createdById      String
  createdBy        User               @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedById      String?
  updatedBy        User?              @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  course           Course?
  bundle           Bundle?
  workshop         Workshop?
  submissions      CourseSubmission[]
  enrollments      Enrollment[]
  certificates     Certificate[]      @relation("ProductCertificates")
  orderItems       OrderItem[]
  price            Decimal            @default(0.0) @db.Decimal(10, 2)
  isFree           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdById])
}

model Course {
  id           String         @id @default(uuid())
  productId    String         @unique
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId     String
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  level        CourseLevel    @default(BEGINNER)
  language     String?        @default("en")
  sections     Section[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  BundleCourse BundleCourse[]

  @@index([authorId])
  @@index([level])
  @@index([categoryId])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bundle {
  id           String         @id @default(uuid())
  productId    String         @unique
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId     String
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  BundleCourse BundleCourse[]

  @@index([authorId])
  @@index([productId])
}

model BundleCourse {
  id        String   @id @default(uuid())
  bundleId  String
  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bundleId])
  @@index([courseId])
}

model WorkshopSession {
  id          String    @id @default(uuid())
  workshopId  String
  workshop    Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  position    Int
  sessions    Session[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workshopId, position])
  @@index([workshopId])
}

model Section {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  position    Int
  sessions    Session[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([courseId, position])
  @@index([courseId])
}

model Workshop {
  id              String            @id @default(uuid())
  productId       String            @unique
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId        String
  author          User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  startTime       DateTime?
  endTime         DateTime?
  meetingUrl      String?
  recordingUrl    String?
  price           Decimal           @default(0.0) @db.Decimal(10, 2)
  isFree          Boolean           @default(true)
  maxAttendees    Int?
  status          WorkshopStatus    @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  WorkshopSession WorkshopSession[]

  @@index([authorId])
  @@index([productId])
  @@index([status])
}

model Video {
  id           String      @id @default(uuid())
  sessionId    String      @unique
  session      Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vimeoVideoId String      @unique
  duration     Int?
  thumbnail    String?
  status       VideoStatus @default(PROCESSING)
  title        String?
  description  String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

model Resource {
  id         String       @id @default(uuid())
  sessionId  String
  session    Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title      String
  type       ResourceType
  url        String?
  storageKey String?
  fileName   String?
  fileSize   Int?
  mimeType   String?
  position   Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([sessionId, position])
  @@index([sessionId])
}

model Session {
  id                String           @id @default(uuid())
  sectionId         String
  section           Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title             String
  description       String?          @db.Text
  position          Int              @default(0)
  status            SessionType      @default(VIDEO)
  isPreview         Boolean          @default(false)
  isFree            Boolean          @default(false)
  video             Video?
  resources         Resource[]
  questionnaire     Questionnaire?
  sessionProgress   SessionProgress[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  WorkshopSession   WorkshopSession? @relation(fields: [workshopSessionId], references: [id])
  workshopSessionId String?

  @@unique([sectionId, position])
  @@index([sectionId])
}

model Questionnaire {
  id           String     @id @default(uuid())
  sessionId    String     @unique
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title        String
  description  String?    @db.Text
  passingScore Int        @default(0)
  maxAttempts  Int        @default(0)
  questions    Question[]
  attempts     QuestionnaireAttempt[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([sessionId])
}

model Question {
  id              String           @id @default(uuid())
  questionnaireId String
  questionnaire   Questionnaire    @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  text            String           @db.Text
  type            QuestionType     @default(MULTIPLE_CHOICE)
  explanation     String?          @db.Text
  position        Int              @default(0)
  options         QuestionOption[]
  answers         QuestionnaireAnswer[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([questionnaireId, position])
  @@index([questionnaireId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([questionId, position])
  @@index([questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model QuestionnaireAttempt {
  id              String               @id @default(uuid())
  questionnaireId String
  questionnaire   Questionnaire        @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  userId          String
  user            User                 @relation("UserQuestionnaireAttempts", fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId    String?
  enrollment      Enrollment?          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status          AttemptStatus        @default(IN_PROGRESS)
  score           Int?
  totalScore      Int?
  scorePercentage Decimal?             @db.Decimal(5, 2)
  isPassed        Boolean?
  answers         QuestionnaireAnswer[]
  startedAt       DateTime             @default(now())
  submittedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([questionnaireId])
  @@index([userId])
  @@index([enrollmentId])
}

model QuestionnaireAnswer {
  id                String               @id @default(uuid())
  attemptId         String
  attempt           QuestionnaireAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]
  isCorrect         Boolean?
  pointsEarned      Int                  @default(0)
  createdAt         DateTime             @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ─── Phase 3: Course Approval & Publishing ───────────────────────────────────

model CourseSubmission {
  id             String           @id @default(uuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  submittedById  String
  submittedBy    User             @relation("SubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedById   String?
  reviewedBy     User?            @relation("SubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  status         SubmissionStatus @default(PENDING)
  reviewComment  String?          @db.Text
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([productId])
  @@index([submittedById])
  @@index([status])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String
  actor      User        @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ─── Phase 4: Enrollments & Student Experience ───────────────────────────────

enum EnrollmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("UserEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?            @relation("RevokedEnrollments", fields: [revokedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sessionProgress SessionProgress[]
  certificate     Certificate?
  questionnaireAttempts QuestionnaireAttempt[]

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([status])
}

model SessionProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessionId    String
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  watchTime    Int        @default(0) // seconds watched
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, sessionId])
  @@index([enrollmentId])
  @@index([sessionId])
}

model Certificate {
  id           String     @id @default(uuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation("ProductCertificates", fields: [productId], references: [id], onDelete: Cascade)
  code         String     @unique // short human-readable verification code
  issuedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([productId])
  @@index([code])
}

// ─── Phase 5: Orders, Payments & VirtuaPayments ─────────────────────────────

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @default(0.0) @db.Decimal(10, 2)
  currency    String      @default("USD")
  items       OrderItem[]
  payment     Payment?
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @default(0.0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("VIRTUAPAYMENTS")
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  idempotencyKey    String?
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([providerPaymentId])
  @@index([createdAt])
}
