{
    "name": "@virtua-lms/api",
    "version": "0.0.1",
    "description": "API layer for the VirtuaLMS platform",
    "private": true,
    "main": "index.js",
    "dependencies": {
        "@nestjs/bullmq": "^12.0.0",
        "@nestjs/common": "^12.1.0",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.1.0",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.1.0",
        "@nestjs/swagger": "^12.0.2",
        "@prisma/client": "6.4.1",
        "@virtua-lms/types": "workspace:*",
        "@virtua-lms/utils": "workspace:*",
        "bullmq": "^6.3.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "ioredis": "^6.0.0",
        "jwks-rsa": "^4.1.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "slugify": "^1.6.9"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.7",
        "@nestjs/schematics": "^12.0.5",
        "@nestjs/testing": "^12.1.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.6.3",
        "@types/passport-jwt": "^4.0.1",
        "cross-env": "^10.1.0",
        "jest": "^30.5.2",
        "prisma": "6.4.1",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.14",
        "ts-node": "^10.9.2",
        "typescript": "~5.7.3"
    },
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                {
                    "useESM": true,
                    "tsconfig": {
                        "module": "ESNext",
                        "moduleResolution": "Bundler"
                    }
                }
            ]
        },
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}